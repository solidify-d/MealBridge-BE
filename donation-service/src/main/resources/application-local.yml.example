# Copy to application-local.yml (gitignored):
#   cp application-local.yml.example application-local.yml

server:
  port: 0

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/

spring:
  config:
    activate:
      on-profile: local
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 24MB
  application:
    name: donation-service
  datasource:
    url: jdbc:mysql://localhost:13306/mealbridge_donation?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
    username: mealbridge
    password: mealbridge
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    open-in-view: false
    properties:
      hibernate:
        format_sql: true

cloud:
  aws:
    credentials:
      access-key: ${S3_ACCESS_KEY:your-aws-access-key}
      secret-key: ${S3_SECRET_KEY:your-aws-secret-key}
    region:
      static: ${AWS_REGION:ap-northeast-2}
    s3:
      enabled: ${S3_ENABLED:false}
      bucket: ${AWS_S3_BUCKET:your-s3-bucket-name}

mealbridge:
  gateway:
    internal-secret: ${GATEWAY_INTERNAL_SECRET:mealbridge-local-gateway-secret}
    internal-auth:
      enabled: true
  demo:
    seed-enabled: true

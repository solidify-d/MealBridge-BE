# Copy to application-local.yml (gitignored):
#   cp application-local.yml.example application-local.yml

server:
  port: 0

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/

spring:
  config:
    activate:
      on-profile: local
  application:
    name: matching-service
  datasource:
    url: jdbc:mysql://localhost:13306/mealbridge_matching?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
    username: mealbridge
    password: mealbridge
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    open-in-view: false
    properties:
      hibernate:
        format_sql: true
  data:
    redis:
      host: localhost
      port: 6379

mealbridge:
  gateway:
    internal-secret: ${GATEWAY_INTERNAL_SECRET:mealbridge-local-gateway-secret}
    internal-auth:
      enabled: true
  notifications:
    redis:
      enabled: true
      channel: mealbridge:notifications:sse
